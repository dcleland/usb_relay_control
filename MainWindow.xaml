<Window x:Class="RelayCtlWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HID Relay Control"
        Height="400"
        Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/RelayCtl.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Relay Boards List -->
        <StackPanel Grid.Column="0" Margin="3">
            <Border BorderBrush="#CCCCCC" BorderThickness="1" Height="25" VerticalAlignment="Top">
                <TextBlock Text="Relay Boards Present" VerticalAlignment="Center" Padding="5"/>
            </Border>
            <ListBox Name="lbBoards" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Right Panel: Control and Log -->
        <DockPanel Grid.Column="1" Margin="3,3,3,3">
            <!-- TabControl -->
            <TabControl Name="PC" DockPanel.Dock="Top" Height="185" Margin="0,0,0,5" SelectionChanged="PC_SelectionChanged">
                <!-- Tab 1: Button per Channel -->
                <TabItem Header="Button per Channel">
                    <Border BorderBrush="#CCCCCC" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Relay Channels" Margin="10,5,10,5" Padding="5"
                                       Background="#F0F0F0" FontWeight="Bold"/>

                            <UniformGrid Columns="4" Margin="8">
                                <!-- Row 1: Relays 1-2 -->
                                <Button Name="sb1On" Tag="1" Content="1 ON" Width="42" Height="22" Margin="2" Click="ChannelButton_Click"/>
                                <Button Name="sb1Off" Tag="2" Content="1 OFF" Width="42" Height="22" Margin="2" Click="ChannelButton_Click"/>
                                <Button Name="sb2On" Tag="3" Content="2 ON" Width="42" Height="22" Margin="2" Click="ChannelButton_Click"/>
                                <Button Name="sb2Off" Tag="4" Content="2 OFF" Width="42" Height="22" Margin="2" Click="ChannelButton_Click"/>

                                <!-- Row 2: Relays 3-4 -->
                                <Button Name="sb3On" Tag="5" Content="3 ON" Width="42" Height="22" Margin="2" Click="ChannelButton_Click"/>
                                <Button Name="sb3Off" Tag="6" Content="3 OFF" Width="42" Height="22" Margin="2" Click="ChannelButton_Click"/>
                                <Button Name="sb4On" Tag="7" Content="4 ON" Width="42" Height="22" Margin="2" Click="ChannelButton_Click"/>
                                <Button Name="sb4Off" Tag="8" Content="4 OFF" Width="42" Height="22" Margin="2" Click="ChannelButton_Click"/>

                                <!-- Row 3: Relays 5-6 -->
                                <Button Name="sb5On" Tag="9" Content="5 ON" Width="42" Height="22" Margin="2" Click="ChannelButton_Click"/>
                                <Button Name="sb5Off" Tag="10" Content="5 OFF" Width="42" Height="22" Margin="2" Click="ChannelButton_Click"/>
                                <Button Name="sb6On" Tag="11" Content="6 ON" Width="42" Height="22" Margin="2" Click="ChannelButton_Click"/>
                                <Button Name="sb6Off" Tag="12" Content="6 OFF" Width="42" Height="22" Margin="2" Click="ChannelButton_Click"/>

                                <!-- Row 4: Relays 7-8 -->
                                <Button Name="sb7On" Tag="13" Content="7 ON" Width="42" Height="22" Margin="2" Click="ChannelButton_Click"/>
                                <Button Name="sb7Off" Tag="14" Content="7 OFF" Width="42" Height="22" Margin="2" Click="ChannelButton_Click"/>
                                <Button Name="sb8On" Tag="15" Content="8 ON" Width="42" Height="22" Margin="2" Click="ChannelButton_Click"/>
                                <Button Name="sb8Off" Tag="16" Content="8 OFF" Width="42" Height="22" Margin="2" Click="ChannelButton_Click"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- Tab 2: On/Off -->
                <TabItem Header="On/Off">
                    <Border BorderBrush="#CCCCCC" BorderThickness="1">
                        <StackPanel Margin="10">
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                                <Button Name="buAllOn" Tag="3" Content="ALL ON" Width="75" Height="25" Margin="5" Click="AllButton_Click"/>
                                <Button Name="buAllOff" Tag="4" Content="ALL OFF" Width="75" Height="25" Margin="5" Click="AllButton_Click"/>
                            </StackPanel>

                            <Separator Margin="0,5,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                                <Button Name="buOn" Tag="1" Content="ON" Width="75" Height="25" Margin="5" Click="AllButton_Click"/>
                                <Button Name="buOff" Tag="2" Content="OFF" Width="75" Height="25" Margin="5" Click="AllButton_Click"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Relay Number:" VerticalAlignment="Center" Margin="5"/>
                                <TextBox Name="seRelNo" Width="50" Height="22" VerticalAlignment="Center" Margin="5" Text="1"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>

            <!-- Log TextBox -->
            <TextBox Name="Log" DockPanel.Dock="Bottom" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     FontFamily="Courier New" IsReadOnly="True" Background="White"/>
        </DockPanel>
    </Grid>
</Window>
